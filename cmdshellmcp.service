[Unit]
Description=cmdshellmcp command-shell MCP server
After=network.target
ConditionPathExists=/var/lib/container-setup/complete

[Service]
Type=simple
User=codeagent
Group=codeagent
WorkingDirectory=/home/codeagent
Environment=HOME=/home/codeagent
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/python/cmdshellmcp/venv/bin/python /usr/local/python/cmdshellmcp/cmdshellmcp2.py --host 0.0.0.0
UMask=0027
NoNewPrivileges=true
#Restart=on-failure
#RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
